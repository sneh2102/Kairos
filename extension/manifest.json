{
  "manifest_version": 3,
  "name": "AI Job Autofill",
  "version": "1.0.0",
  "description": "Fills job applications on any site from your profile, using Claude for the questions.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle",
    "js": ["content.js"]
  }],
  "action": { "default_popup": "popup.html", "default_title": "AI Job Autofill" },
  "options_page": "options.html",
  "commands": {
    "fill": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Fill this page" }
  }
}
